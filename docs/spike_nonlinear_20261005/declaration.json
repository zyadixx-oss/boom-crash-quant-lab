    "aligned_return_12_atr": "s * (close - close.shift(12)) / A",
    "aligned_body_atr": "s * (close - open) / A",
    "range_atr": "R / A",
    "favorable_wick_atr": "(high-max(open,close) for Boom; min(open,close)-low for Crash) / A",
