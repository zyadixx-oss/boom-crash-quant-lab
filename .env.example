APP_ENV=development
DATABASE_URL=sqlite:///./data/signals.db
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_APP_ID=1089

# HARD SAFETY INVARIANTS. The app refuses to start if any are true.
LIVE_TRADING=false
READY_FOR_LIVE=false
LIVE_ALLOWED=false
OPENED_TRADES=false
# normalized invariant used by acceptance checks: live_allowed=false

# AI Strategy Arena
ARENA_MODE=real_24h_shadow_v2
ARENA_MVP_SYMBOLS=["CRASH500","BOOM500"]
ARENA_TRAIN_RATIO=0.60
ARENA_VALIDATION_RATIO=0.20
ARENA_PARAMETER_SENSITIVITY_PCT=0.05
ARENA_MAX_OPTIMIZED_PARAMETERS=3
ARENA_MINIMUM_TRADES=20
ARENA_MINIMUM_PROFIT_FACTOR=1.05
ARENA_MAXIMUM_DRAWDOWN=20.0
ARENA_MINIMUM_EXPECTANCY=0.0
ARENA_MINIMUM_SPIKE_PRECISION=0.20
ARENA_MINIMUM_SPIKE_RECALL=0.10
ARENA_MAXIMUM_FALSE_ALERT_RATE=0.80
ARENA_MINIMUM_OOS_STABILITY=0.35

# Comma-separated origins are supported, for example:
# FRONTEND_ORIGIN=http://localhost:5173,https://your-project.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
